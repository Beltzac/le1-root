# LE1 boot-time clock: last-known-time cache (toybox-compatible subset).
# Deployed to /system/etc/init/timefix.rc
# (reversible: remove this file to undo — see manifest).
#
# Android 8.1 init auto-imports /system/etc/init/*.rc.
#
#   1. loadtime   -> restore last-known time EARLY (post-fs-data = /data up)
#                     so TLS certs validate before any network exists.
#   2. le1timesave-> daemon, keeps the cache fresh (car power-off is abrupt).
#
# Precise network/GPS correction is handled by the Termux time-bootstrap
# (runsvdir time-watchdog), which sets date -u @EPOCH under su every 5 min.

service loadtime /system/bin/loadtime.sh
    user root
    oneshot
    disabled

service le1timesave /system/bin/le1-timesaved.sh
    user root
    disabled

on post-fs-data
    start loadtime

on property:sys.boot_completed=1
    start le1timesave
